-- Core GUCs (DESIGN.md §4.1). Requires the library in shared_preload_libraries.
-- Defaults are read from boot_val, and values are compared with what was set
-- before, so the test does not depend on the server's own configuration.
-- ALTER SYSTEM is used only with invalid values: it validates them (check
-- hooks, bounds) and fails before writing postgresql.auto.conf.
SELECT count(*) AS auto_conf_before
  FROM pg_file_settings
 WHERE name LIKE 'pg\_stat\_statement\_context.%'
   AND sourcefile LIKE '%postgresql.auto.conf' \gset
-- Every GUC, with description, type, default, context, unit and bounds.
\pset format unaligned
SELECT name, short_desc, vartype, boot_val, context, unit, min_val, max_val,
       enumvals
  FROM pg_settings
 WHERE name LIKE 'pg\_stat\_statement\_context.%'
 ORDER BY name COLLATE "C";
name|short_desc|vartype|boot_val|context|unit|min_val|max_val|enumvals
pg_stat_statement_context.bucket_count|Sets the number of time buckets kept for each entry.|integer|12|postmaster||1|10000|
pg_stat_statement_context.bucket_interval|Sets the width of each time bucket.|integer|300|postmaster|s|1|86400|
pg_stat_statement_context.cardinality_cap|Sets the maximum number of distinct values of each tag key.|integer|0|sighup||0|1000000|
pg_stat_statement_context.cardinality_cap_overrides|Sets per-key caps on the number of distinct tag values.|string||sighup||||
pg_stat_statement_context.cardinality_cap_slots|Sets the number of distinct (key, value) pairs the cardinality caps can track.|integer|16384|postmaster||256|67108864|
pg_stat_statement_context.enabled|Enables collection of statement statistics per tag set.|bool|on|superuser||||
pg_stat_statement_context.exclude_tags|Sets the tag keys to discard when tags is "*".|string|traceparent, tracestate, request_id|sighup||||
pg_stat_statement_context.extractors|Sets the extractors that turn SQL comments into tags.|string|sqlcommenter, marginalia|sighup||||
pg_stat_statement_context.max_entries|Sets the maximum number of tracked combinations of query and tag set.|integer|10000|postmaster||100|1073741823|
pg_stat_statement_context.max_tag_value_len|Sets the maximum length of a tag value in bytes.|integer|64|postmaster||1|4096|
pg_stat_statement_context.max_tags|Sets the maximum number of tags stored per entry.|integer|8|postmaster||1|64|
pg_stat_statement_context.max_tagset_bytes|Sets the maximum size of a serialized tag set in bytes.|integer|512|postmaster||128|8192|
pg_stat_statement_context.nested_tags|Selects which tags nested statements get.|enum|inherit|superuser||||{inherit,scan,none}
pg_stat_statement_context.normalize|Sets regex-replace rules that normalize tag values.|string||sighup||||
pg_stat_statement_context.reclaim_worker|Starts a background worker that reclaims expired entries.|bool|off|postmaster||||
pg_stat_statement_context.reclaim_worker_interval|Sets how often the reclaim worker wakes up.|integer|10000|sighup|ms|100|86400000|
pg_stat_statement_context.scan_window|Sets how many bytes at the head or tail of a long statement are searched for comments.|integer|2048|sighup|B|64|1048576|
pg_stat_statement_context.tags|Sets the tag keys to keep ("*" keeps all).|string|action, controller, job|sighup||||
pg_stat_statement_context.tags_override|Sets tags that override the tags of SQL comments in this session or transaction.|string||user||||
pg_stat_statement_context.track|Selects which statements are tracked.|enum|top|superuser||||{none,top,all}
pg_stat_statement_context.track_utility|Selects whether utility commands are tracked.|bool|on|superuser||||
pg_stat_statement_context.untagged|Selects whether statements without tags are recorded.|enum|skip|sighup||||{skip,record}
(22 rows)
\pset format aligned
SELECT count(*) AS gucs,
       count(*) FILTER (WHERE short_desc IS NOT NULL AND short_desc <> '') AS described
  FROM pg_settings
 WHERE name LIKE 'pg\_stat\_statement\_context.%';
 gucs | described 
------+-----------
   22 |        22
(1 row)

-- ---- superuser GUCs: a superuser can SET them ----
SET pg_stat_statement_context.enabled = off;
SHOW pg_stat_statement_context.enabled;
 pg_stat_statement_context.enabled 
-----------------------------------
