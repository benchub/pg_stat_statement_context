RESET pg_stat_statement_context.enabled;
RESET pg_stat_statement_context.track;
RESET pg_stat_statement_context.track_utility;
RESET pg_stat_statement_context.nested_tags;
-- ---- a non-superuser cannot SET superuser GUCs ----
SELECT current_setting('pg_stat_statement_context.enabled') AS enabled_before,
       current_setting('pg_stat_statement_context.track') AS track_before,
       current_setting('pg_stat_statement_context.track_utility') AS track_utility_before,
       current_setting('pg_stat_statement_context.nested_tags') AS nested_tags_before
\gset
CREATE ROLE regress_pssc_nosuper;
SET ROLE regress_pssc_nosuper;
SET pg_stat_statement_context.enabled = off;
ERROR:  permission denied to set parameter "pg_stat_statement_context.enabled"
SET pg_stat_statement_context.track = 'all';
ERROR:  permission denied to set parameter "pg_stat_statement_context.track"
SET pg_stat_statement_context.track_utility = off;
ERROR:  permission denied to set parameter "pg_stat_statement_context.track_utility"
SET pg_stat_statement_context.nested_tags = 'scan';
ERROR:  permission denied to set parameter "pg_stat_statement_context.nested_tags"
SELECT set_config('pg_stat_statement_context.enabled', 'off', true);
ERROR:  permission denied to set parameter "pg_stat_statement_context.enabled"
-- Reading them is allowed, and nothing changed.
SELECT current_setting('pg_stat_statement_context.enabled') = :'enabled_before' AS enabled_kept,
       current_setting('pg_stat_statement_context.track') = :'track_before' AS track_kept,
       current_setting('pg_stat_statement_context.track_utility') = :'track_utility_before' AS track_utility_kept,
       current_setting('pg_stat_statement_context.nested_tags') = :'nested_tags_before' AS nested_tags_kept;
 enabled_kept | track_kept | track_utility_kept | nested_tags_kept 
--------------+------------+--------------------+------------------
 t            | t          | t                  | t
(1 row)

RESET ROLE;
DROP ROLE regress_pssc_nosuper;
-- ---- sighup and postmaster GUCs cannot be SET in a session ----
SET pg_stat_statement_context.scan_window = '4kB';
ERROR:  parameter "pg_stat_statement_context.scan_window" cannot be changed now
SET pg_stat_statement_context.extractors = 'marginalia';
ERROR:  parameter "pg_stat_statement_context.extractors" cannot be changed now
SET pg_stat_statement_context.tags = 'a';
ERROR:  parameter "pg_stat_statement_context.tags" cannot be changed now
SET pg_stat_statement_context.exclude_tags = 'a';
ERROR:  parameter "pg_stat_statement_context.exclude_tags" cannot be changed now
SET pg_stat_statement_context.untagged = 'record';
ERROR:  parameter "pg_stat_statement_context.untagged" cannot be changed now
SET pg_stat_statement_context.max_entries = 1000;
ERROR:  parameter "pg_stat_statement_context.max_entries" cannot be changed without restarting the server
SET pg_stat_statement_context.bucket_count = 6;
ERROR:  parameter "pg_stat_statement_context.bucket_count" cannot be changed without restarting the server
SET pg_stat_statement_context.bucket_interval = '60s';
ERROR:  parameter "pg_stat_statement_context.bucket_interval" cannot be changed without restarting the server
SET pg_stat_statement_context.max_tags = 4;
ERROR:  parameter "pg_stat_statement_context.max_tags" cannot be changed without restarting the server
SET pg_stat_statement_context.max_tag_value_len = 32;
ERROR:  parameter "pg_stat_statement_context.max_tag_value_len" cannot be changed without restarting the server
SET pg_stat_statement_context.max_tagset_bytes = 256;
ERROR:  parameter "pg_stat_statement_context.max_tagset_bytes" cannot be changed without restarting the server
-- ---- invalid values are rejected by validation (nothing is written) ----
-- Bounds: one past each end (bounds of GUCs with units are tested in
-- test/t/003_guc.pl, since PG17+ adds the unit to the range message).
ALTER SYSTEM SET pg_stat_statement_context.max_entries = 99;
ERROR:  99 is outside the valid range for parameter "pg_stat_statement_context.max_entries" (100 .. 1073741823)
ALTER SYSTEM SET pg_stat_statement_context.max_entries = 1073741824;
ERROR:  1073741824 is outside the valid range for parameter "pg_stat_statement_context.max_entries" (100 .. 1073741823)
ALTER SYSTEM SET pg_stat_statement_context.bucket_count = 0;
ERROR:  0 is outside the valid range for parameter "pg_stat_statement_context.bucket_count" (1 .. 10000)
ALTER SYSTEM SET pg_stat_statement_context.bucket_count = 10001;
ERROR:  10001 is outside the valid range for parameter "pg_stat_statement_context.bucket_count" (1 .. 10000)
ALTER SYSTEM SET pg_stat_statement_context.max_tags = 0;
ERROR:  0 is outside the valid range for parameter "pg_stat_statement_context.max_tags" (1 .. 64)
ALTER SYSTEM SET pg_stat_statement_context.max_tags = 65;
ERROR:  65 is outside the valid range for parameter "pg_stat_statement_context.max_tags" (1 .. 64)
ALTER SYSTEM SET pg_stat_statement_context.max_tag_value_len = 0;
ERROR:  0 is outside the valid range for parameter "pg_stat_statement_context.max_tag_value_len" (1 .. 4096)
ALTER SYSTEM SET pg_stat_statement_context.max_tag_value_len = 4097;
ERROR:  4097 is outside the valid range for parameter "pg_stat_statement_context.max_tag_value_len" (1 .. 4096)
ALTER SYSTEM SET pg_stat_statement_context.max_tagset_bytes = 127;
ERROR:  127 is outside the valid range for parameter "pg_stat_statement_context.max_tagset_bytes" (128 .. 8192)
ALTER SYSTEM SET pg_stat_statement_context.max_tagset_bytes = 8193;
ERROR:  8193 is outside the valid range for parameter "pg_stat_statement_context.max_tagset_bytes" (128 .. 8192)
-- Units: bucket_interval is in seconds, scan_window in bytes.
ALTER SYSTEM SET pg_stat_statement_context.bucket_interval = '5 parsecs';
ERROR:  invalid value for parameter "pg_stat_statement_context.bucket_interval": "5 parsecs"
HINT:  Valid units for this parameter are "us", "ms", "s", "min", "h", and "d".
ALTER SYSTEM SET pg_stat_statement_context.scan_window = '2 lightyears';
ERROR:  invalid value for parameter "pg_stat_statement_context.scan_window": "2 lightyears"
HINT:  Valid units for this parameter are "B", "kB", "MB", "GB", and "TB".
-- Enums.
ALTER SYSTEM SET pg_stat_statement_context.untagged = 'maybe';
ERROR:  invalid value for parameter "pg_stat_statement_context.untagged": "maybe"
HINT:  Available values: skip, record.
ALTER SYSTEM SET pg_stat_statement_context.track = 'everything';
ERROR:  invalid value for parameter "pg_stat_statement_context.track": "everything"
HINT:  Available values: none, top, all.
-- tags / exclude_tags syntax.
ALTER SYSTEM SET pg_stat_statement_context.tags = 'action, contr oller';
ERROR:  invalid value for parameter "pg_stat_statement_context.tags": "action, contr oller"
DETAIL:  Tag key "contr oller" contains whitespace.
ALTER SYSTEM SET pg_stat_statement_context.tags = E'action,\tjob\tid';
ERROR:  invalid value for parameter "pg_stat_statement_context.tags": "action,	job	id"
DETAIL:  Tag key "job	id" contains whitespace.
ALTER SYSTEM SET pg_stat_statement_context.tags = 'action,,job';
ERROR:  invalid value for parameter "pg_stat_statement_context.tags": "action,,job"
DETAIL:  The list contains an empty tag key.
ALTER SYSTEM SET pg_stat_statement_context.tags = 'action, job,';
ERROR:  invalid value for parameter "pg_stat_statement_context.tags": "action, job,"
DETAIL:  The list contains an empty tag key.
ALTER SYSTEM SET pg_stat_statement_context.tags = ', action';
ERROR:  invalid value for parameter "pg_stat_statement_context.tags": ", action"
DETAIL:  The list contains an empty tag key.
ALTER SYSTEM SET pg_stat_statement_context.tags = ' , ';
ERROR:  invalid value for parameter "pg_stat_statement_context.tags": " , "
DETAIL:  The list contains an empty tag key.
ALTER SYSTEM SET pg_stat_statement_context.tags = 'action, *';
ERROR:  invalid value for parameter "pg_stat_statement_context.tags": "action, *"
DETAIL:  "*" must be the only entry in the list.
ALTER SYSTEM SET pg_stat_statement_context.tags = '*, *';
ERROR:  invalid value for parameter "pg_stat_statement_context.tags": "*, *"
DETAIL:  "*" must be the only entry in the list.
ALTER SYSTEM SET pg_stat_statement_context.tags = 'act*';
ERROR:  invalid value for parameter "pg_stat_statement_context.tags": "act*"
DETAIL:  Tag key "act*" contains "*".
-- 64-byte key (the limit is 63).
SELECT 'action, ' || repeat('k', 64) AS long_key_list,
       repeat('x', 100) AS very_long_key \gset
ALTER SYSTEM SET pg_stat_statement_context.tags = :'long_key_list';
ERROR:  invalid value for parameter "pg_stat_statement_context.tags": "action, kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk"
DETAIL:  Tag key "kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk..." is longer than 63 bytes.
ALTER SYSTEM SET pg_stat_statement_context.exclude_tags = 'trace parent';
ERROR:  invalid value for parameter "pg_stat_statement_context.exclude_tags": "trace parent"
DETAIL:  Tag key "trace parent" contains whitespace.
ALTER SYSTEM SET pg_stat_statement_context.exclude_tags = '*';
ERROR:  invalid value for parameter "pg_stat_statement_context.exclude_tags": "*"
DETAIL:  "*" is only allowed in pg_stat_statement_context.tags.
ALTER SYSTEM SET pg_stat_statement_context.exclude_tags = 'request_id,,x';
ERROR:  invalid value for parameter "pg_stat_statement_context.exclude_tags": "request_id,,x"
DETAIL:  The list contains an empty tag key.
ALTER SYSTEM SET pg_stat_statement_context.exclude_tags = :'very_long_key';
ERROR:  invalid value for parameter "pg_stat_statement_context.exclude_tags": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
DETAIL:  Tag key "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx..." is longer than 63 bytes.
-- ---- extractors (DESIGN.md §4.2): malformed DSL is rejected with a detail ----
-- (max_tags is assumed to be at its default of 8.)
ALTER SYSTEM SET pg_stat_statement_context.extractors = 'sqlcomenter';
ERROR:  invalid value for parameter "pg_stat_statement_context.extractors": "sqlcomenter"
DETAIL:  Unknown extractor "sqlcomenter".
ALTER SYSTEM SET pg_stat_statement_context.extractors = 'marginalia(url_decode=on)';
ERROR:  invalid value for parameter "pg_stat_statement_context.extractors": "marginalia(url_decode=on)"
DETAIL:  Unknown parameter "url_decode" for extractor "marginalia".
ALTER SYSTEM SET pg_stat_statement_context.extractors = 'sqlcommenter(position=append, position=prepend)';
ERROR:  invalid value for parameter "pg_stat_statement_context.extractors": "sqlcommenter(position=append, position=prepend)"
DETAIL:  Parameter "position" of extractor "sqlcommenter" is given more than once.
ALTER SYSTEM SET pg_stat_statement_context.extractors = 'sqlcommenter(position=middle)';
ERROR:  invalid value for parameter "pg_stat_statement_context.extractors": "sqlcommenter(position=middle)"
DETAIL:  Invalid value "middle" for parameter "position" of extractor "sqlcommenter": expected append, prepend or any.
ALTER SYSTEM SET pg_stat_statement_context.extractors = 'marginalia(kv_sep='','')';
ERROR:  invalid value for parameter "pg_stat_statement_context.extractors": "marginalia(kv_sep=',')"
DETAIL:  Parameter "kv_sep" (",") of extractor "marginalia" contains its pair_sep (","), so it can never match.
ALTER SYSTEM SET pg_stat_statement_context.extractors = 'marginalia(kv_sep=''123456789'')';
ERROR:  invalid value for parameter "pg_stat_statement_context.extractors": "marginalia(kv_sep='123456789')"
DETAIL:  Parameter "kv_sep" of extractor "marginalia" is longer than 8 bytes.
ALTER SYSTEM SET pg_stat_statement_context.extractors = 'regex(pattern=''(a), keys=k)';
ERROR:  invalid value for parameter "pg_stat_statement_context.extractors": "regex(pattern='(a), keys=k)"
DETAIL:  Unterminated quoted value for parameter "pattern" of extractor "regex".
ALTER SYSTEM SET pg_stat_statement_context.extractors = 'regex(pattern=(a), keys=k)';
ERROR:  invalid value for parameter "pg_stat_statement_context.extractors": "regex(pattern=(a), keys=k)"
DETAIL:  Value of parameter "pattern" of extractor "regex" contains "("; quote the whole value.
ALTER SYSTEM SET pg_stat_statement_context.extractors = 'regex(pattern=''(a)\1'', keys=k)';
ERROR:  invalid value for parameter "pg_stat_statement_context.extractors": "regex(pattern='(a)\1', keys=k)"
DETAIL:  Pattern of extractor "regex" uses back-references, which are not allowed.
ALTER SYSTEM SET pg_stat_statement_context.extractors = 'regex(pattern=''(a)(b)(c)(d)(e)(f)(g)(h)(i)'', keys=a|b|c|d|e|f|g|h|i)';
ERROR:  invalid value for parameter "pg_stat_statement_context.extractors": "regex(pattern='(a)(b)(c)(d)(e)(f)(g)(h)(i)', keys=a|b|c|d|e|f|g|h|i)"
DETAIL:  Pattern of extractor "regex" has 9 capture groups, more than max_tags (8).
ALTER SYSTEM SET pg_stat_statement_context.extractors = 'regex(pattern=''(a)(b)'', keys=k)';
ERROR:  invalid value for parameter "pg_stat_statement_context.extractors": "regex(pattern='(a)(b)', keys=k)"
DETAIL:  Extractor "regex" has 1 key but its pattern has 2 capture groups.
ALTER SYSTEM SET pg_stat_statement_context.extractors = 'regex(pattern=''(a'', keys=k)';
ERROR:  invalid value for parameter "pg_stat_statement_context.extractors": "regex(pattern='(a', keys=k)"
DETAIL:  Pattern of extractor "regex" is invalid: parentheses () not balanced.
SELECT 'regex(pattern=''(a)' || repeat('x', 1022) || ''', keys=k)' AS long_pattern \gset
ALTER SYSTEM SET pg_stat_statement_context.extractors = :'long_pattern';
ERROR:  invalid value for parameter "pg_stat_statement_context.extractors": "regex(pattern='(a)', keys=k)"
DETAIL:  Pattern of extractor "regex" is longer than 1024 bytes.
-- None of the rejected ALTER SYSTEM commands wrote anything.
SELECT count(*) = :auto_conf_before AS auto_conf_unchanged
  FROM pg_file_settings
 WHERE name LIKE 'pg\_stat\_statement\_context.%'
   AND sourcefile LIKE '%postgresql.auto.conf';
 auto_conf_unchanged 
---------------------
 t
(1 row)

