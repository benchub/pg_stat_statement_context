# Build/test image for an exact PostgreSQL release built from the official
# source tarball (e.g. 15.0, whose API differs from later 15.x minors).
# Usage: scripts/docker-test.sh <major>.<minor>   e.g. scripts/docker-test.sh 15.0
ARG PG_MAJOR=15
FROM postgres:${PG_MAJOR}
ARG PG_VERSION
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential curl ca-certificates bzip2 libipc-run-perl \
 && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL "https://ftp.postgresql.org/pub/source/v${PG_VERSION}/postgresql-${PG_VERSION}.tar.bz2" \
      | tar -xj -C /usr/src \
 && cd "/usr/src/postgresql-${PG_VERSION}" \
 && ./configure -q --prefix=/usr/local/pgsql --enable-tap-tests \
      --without-readline --without-zlib --without-icu \
 && make -s -j"$(nproc)" \
 && make -s install \
 && make -s -C src/test/perl install \
 && make -s -C src/test/regress install \
 && rm -rf "/usr/src/postgresql-${PG_VERSION}"
ENV PATH=/usr/local/pgsql/bin:$PATH
COPY run-tests.sh /usr/local/bin/run-tests.sh
ENTRYPOINT ["/usr/local/bin/run-tests.sh"]
