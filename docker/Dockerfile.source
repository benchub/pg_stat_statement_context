# Build/test image for an exact PostgreSQL release built from the official
# source tarball (e.g. 15.0, whose API differs from later 15.x minors), with
# pg_stat_statements for the parity checks of the TAP tests.
# PG_FLAVOR selects the build (docker/build-postgres.sh): release (default),
# assert (--enable-cassert) or valgrind (cassert + -DUSE_VALGRIND, plus the
# valgrind package and PostgreSQL's src/tools/valgrind.supp).
# The image holds only PostgreSQL and the toolchain; scripts/docker-test.sh runs
# docker/run-tests.sh from the mounted repository, so editing the test script
# never invalidates a (slow, CI-cached) PostgreSQL build.
# Usage: scripts/docker-test.sh [--assert|--valgrind] <major>[.<minor>]
ARG PG_MAJOR=15
FROM postgres:${PG_MAJOR}
# Not PG_VERSION: the base image sets ENV PG_VERSION (e.g. 17.11-1.pgdg13+2),
# which overrides a same-named ARG under the legacy (non-BuildKit) builder.
ARG PG_SOURCE_VERSION
ARG PG_FLAVOR=release
# bison and flex: PG17+ needs them even when building from a release tarball.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential curl ca-certificates bzip2 bison flex libipc-run-perl \
      $([ "$PG_FLAVOR" = valgrind ] && echo valgrind) \
 && rm -rf /var/lib/apt/lists/*
COPY build-postgres.sh /usr/local/bin/build-postgres.sh
RUN : "${PG_SOURCE_VERSION:?PG_SOURCE_VERSION build-arg is required}" \
 && build-postgres.sh "$PG_SOURCE_VERSION" /usr/local/pgsql "$PG_FLAVOR"
ENV PATH=/usr/local/pgsql/bin:$PATH
