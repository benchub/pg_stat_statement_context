  "panels": [
    {
      "type": "text",
      "id": 1,
      "title": "About this dashboard",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Workload by **context tags** from [pg_stat_statement_context](https://github.com/benchub/pg_stat_statement_context) (recipes in `docs/integrations/`).\n\n* `*_per_second` series are **gauges**: the average over the last *closed* bucket (`bucket_interval`, 5 min by default), so they move in steps. They are already rates: never apply `rate()` to them.\n* **Statement level** defaults to `true`. A top-level statement's time already includes everything it ran (functions, triggers, nested queries, recorded with `toplevel = false` when `track = all`), so adding both levels double-counts. Switch to `false` to see nested work attributed to the calling context.\n* Query IDs: only the top 5 per tag set are exported. Look the text up in `pg_stat_statements` by `queryid`."
      }
    },
    {
      "type": "row",
      "id": 2,
      "title": "Workload by context",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Calls per second by tag",
      "description": "Completed executions per second, per tag set, averaged over the last closed bucket.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (tag_controller, tag_action, tag_job) (pssc_tag_calls_per_second{job=\"$job\", instance=~\"$instance\", datname=~\"$datname\", toplevel=\"$toplevel\", tag_controller=~\"$controller\"})",
          "legendFormat": "{{tag_controller}}#{{tag_action}} {{tag_job}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 4,
      "title": "Execution time by tag (seconds per second)",
      "description": "Execution time per wall-clock second (= average number of statements executing). With Statement level = true this is the time spent on behalf of each context, nested work included.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (tag_controller, tag_action, tag_job) (pssc_tag_exec_seconds_per_second{job=\"$job\", instance=~\"$instance\", datname=~\"$datname\", toplevel=\"$toplevel\", tag_controller=~\"$controller\"})",
          "legendFormat": "{{tag_controller}}#{{tag_action}} {{tag_job}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 5,
      "title": "Mean execution time per call by tag",
      "description": "Execution time divided by calls, over the last closed bucket.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 10,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (tag_controller, tag_action, tag_job) (pssc_tag_exec_seconds_per_second{job=\"$job\", instance=~\"$instance\", datname=~\"$datname\", toplevel=\"$toplevel\", tag_controller=~\"$controller\"}) / (sum by (tag_controller, tag_action, tag_job) (pssc_tag_calls_per_second{job=\"$job\", instance=~\"$instance\", datname=~\"$datname\", toplevel=\"$toplevel\", tag_controller=~\"$controller\"}) > 0)",
          "legendFormat": "{{tag_controller}}#{{tag_action}} {{tag_job}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "type": "table",
      "id": 6,
      "title": "Top tag sets: total over the time range",
      "description": "Execution time and calls over the dashboard time range, per tag set: the per-second gauges integrated over time, counting scrapes where a tag set is absent as 0. Assumes the exporter was scraped throughout the range.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Exec time over range"
              },
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Calls over range"
              },
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Exec time over range",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk(20, sum by (datname, tag_controller, tag_action, tag_job) (sum by (instance, datname, tag_controller, tag_action, tag_job) (sum_over_time(pssc_tag_exec_seconds_per_second{job=\"$job\", instance=~\"$instance\", datname=~\"$datname\", toplevel=\"$toplevel\", tag_controller=~\"$controller\"}[$__range])) / on (instance) group_left max by (instance) (count_over_time(pssc_info_max_entries{job=\"$job\", instance=~\"$instance\"}[$__range]))) * $__range_s)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (datname, tag_controller, tag_action, tag_job) (sum by (instance, datname, tag_controller, tag_action, tag_job) (sum_over_time(pssc_tag_calls_per_second{job=\"$job\", instance=~\"$instance\", datname=~\"$datname\", toplevel=\"$toplevel\", tag_controller=~\"$controller\"}[$__range])) / on (instance) group_left max by (instance) (count_over_time(pssc_info_max_entries{job=\"$job\", instance=~\"$instance\"}[$__range]))) * $__range_s",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ]
    },
