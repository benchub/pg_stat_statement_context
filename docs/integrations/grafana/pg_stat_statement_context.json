    {
      "type": "timeseries",
      "id": 20,
      "title": "Eviction",
      "description": "Per second: eviction passes; expired entries reclaimed (normal housekeeping); live entries evicted (a sign that max_entries is too small); calls dropped because a pass freed nothing (should always be 0).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 54
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 10,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (instance) (rate(pssc_info_dealloc_total{job=\"$job\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "passes/s {{instance}}",
          "range": true,
          "instant": false
        },
