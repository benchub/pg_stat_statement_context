          "expr": "sum by (datname, queryid, tag_controller, tag_action, tag_job) (sum by (instance, datname, queryid, tag_controller, tag_action, tag_job) (sum_over_time(pssc_query_calls_per_second{job=\"$job\", instance=~\"$instance\", datname=~\"$datname\", toplevel=\"$toplevel\", tag_controller=~\"$controller\"}[$__range])) / on (instance) group_left max by (instance) (count_over_time(pssc_info_max_entries{job=\"$job\", instance=~\"$instance\"}[$__range]))) * $__range_s",
          "legendFormat": "__auto",
